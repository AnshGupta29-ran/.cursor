build/
**/build/
.target/
target/
**/target/
.next/
.turbo/
.pytest_cache/
*.pid
.DS_Store
*.log
.git.bak/
**/.git.bak/
# Cursor/VS Code extension binaries (claude.exe >100MB — GitHub rejects)
extensions/
